# Project-wide ignores

# Dependencies
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Environment files
.env
.env.local
.env.*.local
.env.production

# Build outputs
dist/
build/
*.tsbuildinfo

# IDE/Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# OS files
Thumbs.db
.DS_Store

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
.nyc_output/

# Temporary files
tmp/
temp/

# IDE settings (except extensions.json which is often needed)
.vscode/*
!.vscode/extensions.json
